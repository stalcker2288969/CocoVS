{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "wordPattern": "[A-Za-z_.][A-Za-z0-9_.]*|[0-9]+",
  "folding": {
    "markers": {
      "start": "^\\s*(?:asect|rsect|tplate|macro)\\b",
      "end": "^\\s*(?:mend|end)\\b"
    }
  }
}
