{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CdM assembly package",
  "type": "object",
  "required": [
    "name",
    "version",
    "targets",
    "files"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cdm8",
          "cdm8e",
          "cdm16",
          "cdm16e"
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 999,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "$ref": "./cdm-packages.schema.json#/properties/dependencies"
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "languageVersion": {
      "enum": [
        "1.0"
      ],
      "default": "1.0",
      "description": "CocoVS/cdmbot assembly compatibility profile. Profile 1.0 uses CoCAS 0.2.3. Processor selection is independent."
    }
  },
  "additionalProperties": false
}
