{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CdM assembly dependencies",
  "type": "object",
  "required": [
    "version",
    "dependencies"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "dependencies": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,63}$": {
          "oneOf": [
            {
              "const": "*"
            },
            {
              "type": "object",
              "anyOf": [
                {
                  "required": [
                    "git"
                  ]
                },
                {
                  "required": [
                    "builtin"
                  ]
                }
              ],
              "properties": {
                "git": {
                  "type": "string",
                  "minLength": 1
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "default": "main"
                },
                "subdir": {
                  "type": "string",
                  "default": "."
                },
                "builtin": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "languageVersion": {
      "enum": [
        "1.0"
      ],
      "default": "1.0",
      "description": "CocoVS/cdmbot assembly compatibility profile. Profile 1.0 uses CoCAS 0.2.3. Processor selection is independent."
    }
  },
  "additionalProperties": false
}
